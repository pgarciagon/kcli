{
  "targets": {
    "release": {
      "outFile": "build/release/contract.wasm",
      "textFile": "build/release/contract.wat",
      "sourceMap": true,
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": false,
      "use": [
        "BUILD_FOR_TESTING=0"
      ]
    }
  },
  "options": {
    "exportStart": "_start",
    "disable": [
      "sign-extension",
      "bulk-memory"
    ],
    "disableWarning": ["235","228"]
  }
}
